---
import type { MarkdownHeading } from 'astro';
import Layout from './Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  source: string;
  // Level 2 headings are listed in the sidebar.
  headings?: MarkdownHeading[];
  tocLabel?: string;
}
const { title, description, source, headings = [], tocLabel = 'On this page' } = Astro.props;
const toc = headings.filter((h) => h.depth === 2);
---

<Layout {title} {description}>
  <SiteHeader />

  <div class="mx-auto flex max-w-7xl gap-16 px-4 py-12 sm:px-6 sm:py-20 lg:px-8">
    {
      toc.length > 0 && (
        <nav aria-label={tocLabel} class="sticky top-28 hidden max-h-[calc(100dvh-8rem)] w-56 shrink-0 self-start overflow-y-auto lg:block">
          <p class="font-mono text-sm font-medium tracking-wide text-brand uppercase">{tocLabel}</p>
          <ul class="mt-4 flex flex-col border-l border-line text-[15px]">
            {toc.map((h) => (
              <li>
                <a href={`#${h.slug}`} class="-ml-px block border-l border-transparent py-1.5 pl-4 text-slate-ink hover:border-ink hover:text-ink">
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
    <main id="main" class="doc min-w-0 max-w-3xl grow">
      <slot />
    </main>
  </div>

  <SiteFooter {source} />
</Layout>

<style>
  .doc :global(h1) {
    font-size: clamp(2.5rem, 6vw, 3.5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.035em;
  }
  .doc :global(h2) {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-line);
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    scroll-margin-top: 5rem;
  }
  .doc :global(h3) {
    margin-top: 2rem;
    font-size: 1.125rem;
    font-weight: 700;
    scroll-margin-top: 5rem;
  }
  .doc :global(p),
  .doc :global(ul),
  .doc :global(ol),
  .doc :global(table) {
    margin-top: 1rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-slate-ink);
  }
  .doc :global(h3 + ul) {
    margin-top: 0.5rem;
  }
  .doc :global(ul) {
    padding-left: 1.25rem;
    list-style: disc;
  }
  .doc :global(ol) {
    padding-left: 1.25rem;
    list-style: decimal;
  }
  .doc :global(li + li) {
    margin-top: 0.5rem;
  }
  .doc :global(strong) {
    color: var(--color-ink);
    font-weight: 600;
  }
  .doc :global(a) {
    color: var(--color-brand);
    text-decoration: underline;
  }
  .doc :global(a:hover) {
    color: var(--color-brand-deep);
  }
  .doc :global(h2 a) {
    color: inherit;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  .doc :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--color-ink);
  }
  .doc :global(table) {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .doc :global(th),
  .doc :global(td) {
    padding: 0.625rem 1rem 0.625rem 0;
    border-bottom: 1px solid var(--color-line);
    text-align: left;
    vertical-align: top;
  }
  .doc :global(th) {
    color: var(--color-ink);
    font-weight: 600;
  }
</style>
