---
import { Image } from 'astro:assets';
import icon from '../../../extension/icons/icon128.png';
import ChromeIcon from './ChromeIcon.astro';
import { REPO, DOWNLOAD, base } from '../links';

const path = Astro.url.pathname;
const links = [
  { href: `${base}/docs/`, label: 'Docs' },
  { href: `${base}/changelog/`, label: 'Changelog' },
  { href: `${base}/privacy/`, label: 'Privacy' },
  { href: `${base}/#faq`, label: 'FAQ' },
];
---

<a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-30 focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:text-ink">
  Skip to content
</a>
<header class="sticky top-0 z-20 border-b border-white/10 bg-deep text-white">
  <nav class="mx-auto flex max-w-7xl items-center gap-8 px-4 py-3 sm:px-6 lg:px-8" aria-label="Main">
    <a href={`${base}/`} class="flex min-h-11 items-center gap-2.5 text-lg font-bold">
      <Image src={icon} alt="" width={30} height={30} densities={[1, 2, 3]} loading="eager" class="rounded-md" />
      Veil
    </a>
    <div class="ml-auto hidden items-center gap-7 text-white/75 lg:flex">
      {
        links.map((l) => (
          <a href={l.href} class="hover:text-white aria-[current=page]:text-white" aria-current={path.startsWith(l.href) ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
      <a href={REPO} target="_blank" rel="noopener" class="flex items-center gap-2 hover:text-white">
        <svg viewBox="0 0 16 16" class="size-[18px]" fill="currentColor" aria-hidden="true"><path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"/></svg>
        GitHub
      </a>
    </div>
    <a
      href={DOWNLOAD}
      target="_blank"
      rel="noopener"
      class="ml-auto inline-flex min-h-11 items-center justify-center gap-2 rounded-full bg-white px-4 py-2 text-[15px] font-semibold whitespace-nowrap text-deep transition-colors hover:bg-brand-light focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-white motion-reduce:transition-none lg:ml-0"
    >
      <ChromeIcon />
      Add to Chrome
    </a>
  </nav>
</header>
