---
import { Image } from 'astro:assets';
import icon from '../../../extension/icons/icon128.png';
import { REPO, DOWNLOAD, base } from '../links';

const path = Astro.url.pathname;
const links = [
  { href: `${base}/docs/`, label: 'Docs' },
  { href: `${base}/changelog/`, label: 'Changelog' },
  { href: `${base}/privacy/`, label: 'Privacy' },
  { href: `${base}/#faq`, label: 'FAQ' },
];
---

<a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-30 focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:text-ink">
  Skip to content
</a>
<header class="sticky top-0 z-20 border-b border-white/10 bg-deep text-white">
  <nav class="mx-auto flex max-w-7xl items-center gap-8 px-4 py-3 sm:px-6 lg:px-8" aria-label="Main">
    <a href={`${base}/`} class="flex min-h-11 items-center gap-2.5 text-lg font-bold">
      <Image src={icon} alt="" width={30} height={30} densities={[1, 2, 3]} loading="eager" class="rounded-md" />
      Veil
    </a>
    <div class="ml-auto hidden items-center gap-7 text-white/75 lg:flex">
      {
        links.map((l) => (
          <a href={l.href} class="hover:text-white aria-[current=page]:text-white" aria-current={path.startsWith(l.href) ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
      <a href={REPO} target="_blank" rel="noopener" class="hover:text-white">GitHub</a>
    </div>
    <a
      href={DOWNLOAD}
      target="_blank"
      rel="noopener"
      class="ml-auto inline-flex min-h-11 items-center justify-center rounded-xl bg-white px-4 py-2 text-[15px] font-semibold whitespace-nowrap text-deep transition-colors hover:bg-brand-light focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-white motion-reduce:transition-none lg:ml-0"
    >
      Add to Chrome
    </a>
  </nav>
</header>
